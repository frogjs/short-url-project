generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ShortUrl {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  originalUrl String
  visits      Int      @default(0)
  createdAt   DateTime @default(now())
}
